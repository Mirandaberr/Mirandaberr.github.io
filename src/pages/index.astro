---
import Base from '../layouts/Base.astro';
import Stack from '../components/Stack.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { sitio } from '../data/sitio.mjs';
import { presentacion, destacados, experiencia, habilidades } from '../data/perfil';
import foto from '../assets/perfil.jpg';

const ULTIMOS_ESCRITOS = 3;
const escritos = (await getCollection('escritos', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, ULTIMOS_ESCRITOS);
---
<Base>
  <section class="hero">
    <div class="foto pixel-borde">
      <Image src={foto} alt={`Foto de ${presentacion.nombre}`} width={320} height={320} loading="eager" class="pixel-borde" />
    </div>
    <div>
      <p class="muted ubicacion">~/{presentacion.ubicacion}</p>
      <h1>{presentacion.nombre}<span class="cursor" aria-hidden="true">_</span></h1>
      <p class="rol">{presentacion.rol}</p>
      <p class="resumen">{presentacion.resumen}</p>
      <div class="acciones">
        <a class="boton primario" href={sitio.cv} download>Descargar CV</a>
        <a class="boton" href="#contacto">Contactar</a>
      </div>
    </div>
  </section>

  <h2>Stack</h2>
  <Stack />

  <h2>Destacados</h2>
  <div class="destacados">
    {destacados.map((d) => (
      <article class="tarjeta">
        <p class="cifra">{d.cifra}</p>
        <h3>{d.titulo}</h3>
        <p class="muted">{d.detalle}</p>
      </article>
    ))}
  </div>

  <h2>Experiencia</h2>
  <ol class="experiencia">
    {experiencia.map((e) => (
      <li>
        <div class="cabeza">
          <h3>{e.cargo} <span class="empresa">@ {e.empresa}</span></h3>
          <p class="muted periodo">{e.periodo} · {e.modalidad}</p>
        </div>
        <ul>{e.logros.map((l) => <li>{l}</li>)}</ul>
      </li>
    ))}
  </ol>

  <h2>Habilidades</h2>
  <dl class="habilidades">
    {habilidades.map((h) => (
      <div>
        <dt>{h.area}</dt>
        <dd>{h.items.map((i) => <span class="etiqueta">{i}</span>)}</dd>
      </div>
    ))}
  </dl>

  {escritos.length > 0 && (
    <>
      <h2>Escritos recientes</h2>
      <ul class="lista-escritos">
        {escritos.map((e) => (
          <li>
            <a href={`/escritos/${e.id}/`}>{e.data.titulo}</a>
            <p class="muted">{e.data.resumen}</p>
          </li>
        ))}
      </ul>
      <a href="/escritos/">Ver todos →</a>
    </>
  )}

  <h2 id="contacto">Contacto</h2>
  <p>¿Crees que podemos hacer un buen match? Contáctame por cualquiera de mis canales.</p>
  <div class="acciones">
    <a class="boton primario" href={`mailto:${sitio.email}`}>{sitio.email}</a>
    <a class="boton" href={sitio.linkedin}>LinkedIn</a>
    <a class="boton" href={sitio.github}>GitHub</a>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 3.5rem 0 0.5rem;
  }
  /* El fondo del contenedor hace de borde ámbar alrededor de la foto. */
  .foto { background: var(--accent); padding: 5px; line-height: 0; }
  .foto :global(img) { width: 100%; height: auto; display: block; }
  .ubicacion { margin: 0; font-size: 0.9rem; }
  .hero h1 { font-size: clamp(2.8rem, 8vw, 4.2rem); margin: 0.2rem 0 0; color: var(--text); }
  .cursor { color: var(--accent); animation: parpadeo 1.1s steps(1) infinite; }
  @keyframes parpadeo { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  .rol { font-family: var(--pixel); font-size: 1.8rem; color: var(--accent); margin: 0.2rem 0 1rem; }
  .resumen { max-width: 36rem; margin: 0; }
  .acciones { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.75rem; }

  @media (max-width: 40rem) {
    .hero { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 2.5rem; }
    .foto { width: 10rem; }
  }

  .destacados { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .tarjeta { background: var(--surface); padding: 1.2rem 1.3rem; border: 2px solid var(--line); border-top: 4px solid var(--accent); box-shadow: 4px 4px 0 var(--line); }
  .tarjeta h3 { margin: 0.3rem 0 0.5rem; }
  .tarjeta p { margin: 0; font-size: 0.9rem; }
  .tarjeta .cifra { font-family: var(--pixel); font-size: 2.4rem; line-height: 1; color: var(--accent); }

  .experiencia { list-style: none; padding: 0; margin: 0; }
  .experiencia > li { border-left: 2px dashed var(--line); padding: 0 0 2rem 1.4rem; position: relative; }
  /* Marcador cuadrado sobre la línea de tiempo. */
  .experiencia > li::before {
    content: ''; position: absolute; left: -7px; top: 0.35rem;
    width: 12px; height: 12px; background: var(--accent);
  }
  .experiencia h3 { margin: 0; }
  .empresa { color: var(--accent); }
  .periodo { margin: 0.2rem 0 0.6rem; font-size: 0.85rem; }
  .experiencia ul { margin: 0; padding-left: 1.2rem; list-style: square; }
  .experiencia ul li { margin: 0.35rem 0; }
  .experiencia ul li::marker { color: var(--accent); }

  .habilidades { margin: 0; }
  .habilidades > div { display: grid; grid-template-columns: 11rem 1fr; gap: 0.5rem; margin-bottom: 0.4rem; }
  .habilidades dt { font-family: var(--pixel); font-size: 1.4rem; color: var(--accent); }
  .habilidades dd { margin: 0; }
  @media (max-width: 34rem) {
    .habilidades > div { grid-template-columns: 1fr; gap: 0.2rem; }
  }

  .lista-escritos { list-style: none; padding: 0; }
  .lista-escritos li { margin-bottom: 1rem; }
  .lista-escritos p { margin: 0.2rem 0 0; }
</style>
